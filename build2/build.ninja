build clx: CXX_EXECUTABLE_LINKER__clx_Release CMakeFiles/clx.dir/src/clx.cpp.o CMakeFiles/clx.dir/src/syntax/lexer.cpp.o CMakeFiles/clx.dir/src/syntax/parser.cpp.o CMakeFiles/clx.dir/src/optimizer/optimizer.cpp.o CMakeFiles/clx.dir/src/optimizer/owners.cpp.o CMakeFiles/clx.dir/src/optimizer/numbers.cpp.o CMakeFiles/clx.dir/src/optimizer/functions.cpp.o CMakeFiles/clx.dir/src/optimizer/tables.cpp.o CMakeFiles/clx.dir/src/optimizer/structs.cpp.o CMakeFiles/clx.dir/src/codegen/codegen.cpp.o CMakeFiles/clx.dir/src/codegen/helpers.cpp.o CMakeFiles/clx.dir/src/codegen/expressions.cpp.o CMakeFiles/clx.dir/src/codegen/statements.cpp.o CMakeFiles/clx.dir/src/codegen/loops.cpp.o CMakeFiles/clx.dir/src/codegen/assignments.cpp.o
  FLAGS = -include climits -O3 -DNDEBUG
  OBJECT_DIR = CMakeFiles/clx.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = CMakeFiles/clx.dir/
  TARGET_FILE = clx
  TARGET_PDB = clx.pdb


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/clx/build2 && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/clx/build2 && /usr/bin/cmake --regenerate-during-build -S/home/user/clx -B/home/user/clx/build2
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build list_install_components: phony


#############################################
# Utility command for install

build CMakeFiles/install.util: CUSTOM_COMMAND all
  COMMAND = cd /home/user/clx/build2 && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build install: phony CMakeFiles/install.util


#############################################
# Utility command for install/local

build CMakeFiles/install/local.util: CUSTOM_COMMAND all
  COMMAND = cd /home/user/clx/build2 && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build install/local: phony CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build CMakeFiles/install/strip.util: CUSTOM_COMMAND all
  COMMAND = cd /home/user/clx/build2 && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build install/strip: phony CMakeFiles/install/strip.util

